{
	"name": "fixmycity2",
	"main": "worker.js",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "IDENTITY_SESSIONS",
				"class_name": "IdentitySession"
			},
			{
				"name": "VERIFICATION_BUDGET",
				"class_name": "VerificationBudget"
			},
			{
				"name": "VOICE_GATEWAY",
				"class_name": "VoiceGateway"
			},
			{
				"name": "REPORT_AI",
				"class_name": "ReportAI"
			}
		]
	},
	"migrations": [
		{
			"tag": "identity-v1",
			"new_sqlite_classes": [
				"IdentitySession",
				"VerificationBudget"
			]
		},
		{
			"tag": "voice-v1",
			"new_sqlite_classes": [
				"VoiceGateway"
			]
		},
		{
			"tag": "report-ai-v1",
			"new_sqlite_classes": [
				"ReportAI"
			]
		}
	],
	"ratelimits": [
		{
			"name": "REPORT_RATE_LIMIT",
			"namespace_id": "2810202604",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "IDENTITY_RATE_LIMIT",
			"namespace_id": "2810202602",
			"simple": {
				"limit": 12,
				"period": 60
			}
		},
		{
			"name": "VOICE_RATE_LIMIT",
			"namespace_id": "2810202603",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"vars": {
		"IDENTITY_DAILY_START_LIMIT": "200",
		"IDENTITY_DAILY_MODEL_LIMIT": "100",
		"VOICE_DAILY_CALL_LIMIT": "60",
		"VOICE_IP_DAILY_CALL_LIMIT": "20"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"routes": [
		{
			"pattern": "fixmycity.online",
			"custom_domain": true
		}
	],
	"hyperdrive": [
		{
			"binding": "FMC_DATABASE",
			"id": "1c5c9ffd096040a3aa77468a5e574c50"
		}
	]
}
