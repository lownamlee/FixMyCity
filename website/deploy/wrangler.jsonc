{
  "name": "fixmycity",
  "main": "worker.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "lownamlee.com/fixmycity",
      "zone_name": "lownamlee.com"
    },
    {
      "pattern": "lownamlee.com/fixmycity/*",
      "zone_name": "lownamlee.com"
    }
  ]
}
